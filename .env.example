REACT_APP_WEBEX_AUTH_MODE=php
REACT_APP_WEBEX_TOKEN_ENDPOINT=api/webex/token.php
REACT_APP_WEBEX_LOGIN_ENDPOINT=api/webex/login.php
REACT_APP_WEBEX_LOGOUT_ENDPOINT=api/webex/logout.php
REACT_APP_CALENDAR_URL=/calendarfrontend/

# Only needed if you deliberately switch back to browser implicit auth.
REACT_APP_WEBEX_CLIENT_ID=your-webex-oauth-client-id
REACT_APP_WEBEX_REDIRECT_URI=https://ehr.example.com/wdihehr-v2/
